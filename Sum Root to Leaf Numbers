class Solution {
    int total = 0;
    public int sumNumbers(TreeNode root) {
        nodeSum(root, 0);

        return total;
    }

    void nodeSum(TreeNode root, int curr) {
        if (root == null) {
            return;
        }

        curr = curr * 10 + root.val;

        if (root.left == null && root.right == null) {
            total += curr;
            return;
        }

        nodeSum(root.left, curr);
        nodeSum(root.right, curr);
    }
}
