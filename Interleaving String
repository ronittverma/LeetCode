class Solution {
    public boolean isInterleave(String s1, String s2, String s3) {

        int m = s1.length();
        int n = s2.length();

        // Lengths must match
        if (m + n != s3.length()) {
            return false;
        }

        boolean[][] dp = new boolean[m + 1][n + 1];

        // Empty s1 and empty s2 form empty s3
        dp[0][0] = true;

        // Use only s1
        for (int i = 1; i <= m; i++) {
            dp[i][0] = dp[i - 1][0]
                    && s1.charAt(i - 1) == s3.charAt(i - 1);
        }

        // Use only s2
        for (int j = 1; j <= n; j++) {
            dp[0][j] = dp[0][j - 1]
                    && s2.charAt(j - 1) == s3.charAt(j - 1);
        }

        // Fill the DP table
        for (int i = 1; i <= m; i++) {
            for (int j = 1; j <= n; j++) {

                char target = s3.charAt(i + j - 1);

                // Take character from s1
                boolean fromS1 =
                    dp[i - 1][j] &&
                    s1.charAt(i - 1) == target;

                // Take character from s2
                boolean fromS2 =
                    dp[i][j - 1] &&
                    s2.charAt(j - 1) == target;

                dp[i][j] = fromS1 || fromS2;
            }
        }

        return dp[m][n];
    }
}
